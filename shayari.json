<escape>
{"id":101,"category":"दर्द","text":"हर मुस्कान के पीछे कहानी नहीं दिखती,\nहर ख़ामोशी में दुनिया को परेशानी नहीं दिखती।"},
{"id":102,"category":"दर्द","text":"कुछ सवालों के जवाब वक़्त देता है,\nऔर कुछ का बोझ इंसान ख़ुद सहता है।"},
{"id":103,"category":"दर्द","text":"यादों का मौसम अक्सर लौट आता है,\nबीता हुआ पल फिर दिल को छू जाता है।"},
{"id":104,"category":"दर्द","text":"रिश्तों की अहमियत वक़्त समझाता है,\nकौन अपना है, मुश्किल समय बताता है।"},
{"id":105,"category":"दर्द","text":"कभी उम्मीदें भी थककर बैठ जाती हैं,\nजब अपनी ही बातें दिल को समझ नहीं आती हैं।"},
{"id":106,"category":"दर्द","text":"हर कहानी का अंत मुस्कान नहीं होता,\nहर सफ़र में इंसान मेहमान नहीं होता।"},
{"id":107,"category":"दर्द","text":"कुछ लम्हे दिल में तस्वीर बन जाते हैं,\nसाल बीत जाएँ फिर भी याद आते हैं।"},
{"id":108,"category":"दर्द","text":"जो वादे कभी बहुत अपने लगते थे,\nआज वही लफ़्ज़ अधूरे सपने लगते हैं।"},
{"id":109,"category":"दर्द","text":"दिल की बातें हर किसी को बताई नहीं जातीं,\nकुछ यादें चाहकर भी भुलाई नहीं जातीं।"},
{"id":110,"category":"दर्द","text":"वक़्त के साथ बहुत कुछ बदल जाता है,\nकभी अपना भी अजनबी नज़र आता है।"},
{"id":111,"category":"प्यार","text":"तेरे ख़याल से ही दिन में बहार आ जाती है,\nसूनी राहों पर भी मुस्कान छा जाती है।"},
{"id":112,"category":"प्यार","text":"दिल की किताब में तेरा नाम सँभाल रखा है,\nहर ख़ुशी के पास तेरा ख़याल रख छोड़ा है।"},
{"id":113,"category":"प्यार","text":"तेरी हँसी से मौसम बदलता सा लगता है,\nदिल को हर लम्हा नया लगता है।"},
{"id":114,"category":"प्यार","text":"तेरी आँखों में सपनों का जहाँ दिखता है,\nतेरे साथ हर रास्ता आसान दिखता है।"},
{"id":115,"category":"प्यार","text":"मिलना हो तो बहाने नहीं बनाए जाते,\nसच्चे रिश्ते दिल से निभाए जाते हैं।"},
{"id":116,"category":"प्यार","text":"तेरे नाम से सुबह की शुरुआत हो जाए,\nमेरे हर दिन में थोड़ी मिठास हो जाए।"},
{"id":117,"category":"प्यार","text":"तू मिले तो लम्हा यादगार बन जाता है,\nतेरा साथ हर मौसम का त्योहार बन जाता है।"},
{"id":118,"category":"प्यार","text":"न कोई शर्त हो, न कोई हिसाब हो,\nबस रिश्ते में सच्चाई और बेहिसाब प्यार हो।"},
{"id":119,"category":"प्यार","text":"तेरी एक बात दिन बना देती है,\nतेरी याद भी चेहरे पर हँसी ला देती है।"},
{"id":120,"category":"प्यार","text":"मोहब्बत में सबसे सुंदर एहसास है भरोसा,\nजो दिल को दे जाता है अपनापन का भरोसा।"},
{"id":121,"category":"दोस्ती","text":"दोस्ती में न कोई छोटा न बड़ा होता है,\nसच्चा दोस्त हर हाल में खड़ा होता है।"},
{"id":122,"category":"दोस्ती","text":"दोस्तों के संग हर शाम निराली होती है,\nछोटी सी महफ़िल भी खुशियों वाली होती है।"},
{"id":123,"category":"दोस्ती","text":"जब दुनिया सवालों में उलझाती है,\nदोस्त की एक बात हिम्मत बढ़ाती है।"},
{"id":124,"category":"दोस्ती","text":"दोस्ती में चेहरे नहीं दिल देखे जाते हैं,\nसच्चे यार मुश्किल में पहचाने जाते हैं।"},
{"id":125,"category":"दोस्ती","text":"कभी रूठना तो कभी मनाना याद रहेगा,\nदोस्ती का हर पुराना फ़साना याद रहेगा।"},
{"id":126,"category":"दोस्ती","text":"जो पीठ पीछे भी सम्मान बनाए रखे,\nवही दोस्ती का रिश्ता दिल में बसाए रखे।"},
{"id":127,"category":"दोस्ती","text":"दोस्त की ख़ुशी में अपनी ख़ुशी ढूँढ़ लेना,\nयही है यारी, इसे हमेशा सँभाल लेना।"},
{"id":128,"category":"दोस्ती","text":"सफ़र में साथ हो तो राह आसान लगती है,\nदोस्तों की बात हर शाम ख़ास लगती है।"},
{"id":129,"category":"दोस्ती","text":"नज़रें मिलें तो पुरानी बात याद आती है,\nदोस्तों की महफ़िल फिर मुस्कुराती है।"},
{"id":130,"category":"दोस्ती","text":"सच्ची यारी में दूरी दीवार नहीं बनती,\nवक़्त की कमी से दोस्ती बेकार नहीं बनती।"},
{"id":131,"category":"एटीट्यूड","text":"हमारी पहचान हमारे काम से होगी,\nहर नई सुबह एक नई उड़ान से होगी।"},
{"id":132,"category":"एटीट्यूड","text":"हम शोर नहीं, अपनी मेहनत रखते हैं,\nअपने उसूलों पर चलने की आदत रखते हैं।"},
{"id":133,"category":"एटीट्यूड","text":"हर किसी को खुश करना हमारा काम नहीं,\nसच्चाई से जीना कोई आम काम नहीं।"},
{"id":134,"category":"एटीट्यूड","text":"अपना अंदाज़ अपनी पहचान रखते हैं,\nमुश्किलों में भी चेहरे पर मुस्कान रखते हैं।"},
{"id":135,"category":"एटीट्यूड","text":"नक़ल करने से पहचान नहीं बनती,\nमेहनत के बिना कोई उड़ान नहीं बनती।"},
{"id":136,"category":"एटीट्यूड","text":"हमारी सादगी को कमज़ोरी मत समझना,\nअपने इरादों को कभी हल्का मत समझना।"},
{"id":137,"category":"एटीट्यूड","text":"जो काम से जवाब देते हैं,\nवही इतिहास में नाम लेते हैं।"},
{"id":138,"category":"एटीट्यूड","text":"अपने सपनों का रास्ता खुद चुनते हैं,\nहम हालात से नहीं, हौसलों से चलते हैं।"},
{"id":139,"category":"एटीट्यूड","text":"सम्मान देना हमारी पहचान है,\nआत्मसम्मान रखना हमारा स्वाभिमान है।"},
{"id":140,"category":"एटीट्यूड","text":"भीड़ में खोना हमें मंज़ूर नहीं,\nअपनी अलग पहचान बनाना कोई गुरूर नहीं।"},
{"id":141,"category":"मोटिवेशन","text":"मेहनत की रोशनी कभी बेकार नहीं जाती,\nसच्ची लगन मंज़िल तक ले जाती।"},
{"id":142,"category":"मोटिवेशन","text":"आज का छोटा प्रयास कल रंग लाएगा,\nधैर्य रखने वाला आगे बढ़ जाएगा।"},
{"id":143,"category":"मोटिवेशन","text":"रास्तों की कठिनाई से घबराना नहीं,\nअपने सपनों को अधूरा छोड़ जाना नहीं।"},
{"id":144,"category":"मोटिवेशन","text":"हर दिन खुद को बेहतर बनाते रहो,\nअपने लक्ष्य की ओर कदम बढ़ाते रहो।"},
{"id":145,"category":"मोटिवेशन","text":"समय की क़ीमत पहचानना सीखो,\nअपने हुनर को हर दिन तराशना सीखो।"},
{"id":146,"category":"मोटिवेशन","text":"सपनों को सच करने की तैयारी करो,\nहर दिन कुछ नया सीखने की शुरुआत करो।"},
{"id":147,"category":"मोटिवेशन","text":"मुश्किल सवालों से सीख मिलती है,\nकोशिश करने से नई राह मिलती है।"},
{"id":148,"category":"मोटिवेशन","text":"मंज़िल उन्हीं को मिलती है जो चलते हैं,\nजो ठान लेते हैं वही आगे निकलते हैं।"},
{"id":149,"category":"मोटिवेशन","text":"अपने हुनर पर विश्वास बनाए रखना,\nधीरे सही मगर आगे कदम बढ़ाते रहना।"},
{"id":150,"category":"मोटिवेशन","text":"सफलता कोई एक दिन का काम नहीं,\nलगातार प्रयास से बनती पहचान सही।"},
{"id":151,"category":"भक्ति","text":"मन में श्रद्धा और कर्म में उजाला रखो,\nहर इंसान के लिए प्रेम का प्याला रखो।"},
{"id":152,"category":"भक्ति","text":"ईश्वर से बस इतनी सी दुआ माँगते हैं,\nसबके जीवन में खुशियों की हवा माँगते हैं।"},
{"id":153,"category":"भक्ति","text":"जहाँ दया और सेवा का भाव होता है,\nवहीं सच्चे धर्म का प्रभाव होता है।"},
{"id":154,"category":"भक्ति","text":"अच्छे कर्मों से जीवन सँवर जाता है,\nविनम्र मन हर दिल में उतर जाता है।"},
{"id":155,"category":"भक्ति","text":"प्रार्थना मन को शांति सिखाती है,\nश्रद्धा कठिन राह में हिम्मत जगाती है।"},
{"id":156,"category":"भक्ति","text":"किसी के चेहरे पर मुस्कान लाना,\nईश्वर की बनाई दुनिया को सुंदर बनाना।"},
{"id":157,"category":"भक्ति","text":"अहंकार से मन का उजाला खो जाता है,\nप्रेम से हर रिश्ता निराला हो जाता है।"},
{"id":158,"category":"भक्ति","text":"मंदिर के साथ मन को भी साफ़ रखना,\nहर इंसान के लिए अच्छा भाव रखना।"},
{"id":159,"category":"भक्ति","text":"सेवा का दीप दिल में जलाते रहो,\nनेकी की राह पर कदम बढ़ाते रहो।"},
{"id":160,"category":"भक्ति","text":"सच्चाई से बढ़कर कोई श्रृंगार नहीं,\nदया से बढ़कर कोई उपहार नहीं।"},
{"id":161,"category":"देशभक्ति","text":"भारत की धरती से पहचान हमारी है,\nइसकी एकता ही सबसे बड़ी शान हमारी है।"},
{"id":162,"category":"देशभक्ति","text":"तिरंगा हमें मिलकर रहना सिखाता है,\nहर रंग एक सुंदर संदेश बताता है।"},
{"id":163,"category":"देशभक्ति","text":"देश आगे बढ़े तो हर दिल मुस्कुराए,\nज्ञान और मेहनत से नया भारत बनाएँ।"},
{"id":164,"category":"देशभक्ति","text":"किसान की मेहनत, जवान का सम्मान,\nइनसे ही मजबूत बनता हिंदुस्तान।"},
{"id":165,"category":"देशभक्ति","text":"वतन की मिट्टी का मान बनाए रखना,\nहर नागरिक का सम्मान बनाए रखना।"},
{"id":166,"category":"देशभक्ति","text":"अलग-अलग भाषा, अलग-अलग वेश,\nफिर भी दिल से एक है अपना देश।"},
{"id":167,"category":"देशभक्ति","text":"ईमानदारी से अपना फ़र्ज़ निभाएँ,\nभारत को नई ऊँचाइयों तक ले जाएँ।"},
{"id":168,"category":"देशभक्ति","text":"शिक्षा की लौ हर घर में जलानी है,\nमिलकर देश की तस्वीर सजानी है।"},
{"id":169,"category":"देशभक्ति","text":"देश का सम्मान हर दिल में रहे,\nएकता का दीप हर घर में जले।"},
{"id":170,"category":"देशभक्ति","text":"अपनी धरती से सच्चा प्यार रखें,\nइसके भविष्य की ज़िम्मेदारी स्वीकारें।"},
{"id":171,"category":"रात","text":"चाँदनी रात में ख़्वाब सजाते हैं,\nसुबह के लिए नए इरादे बनाते हैं।"},
{"id":172,"category":"रात","text":"तारों की चमक कुछ कह जाती है,\nख़ामोश रात उम्मीद जगा जाती है।"},
{"id":173,"category":"रात","text":"रात की हवा में ठंडक सी छाई है,\nलगता है कोई प्यारी याद लौट आई है।"},
{"id":174,"category":"रात","text":"दिन भर की थकान को भूल जाना,\nरात में एक सुंदर सपना सजाना।"},
{"id":175,"category":"रात","text":"चाँद को देखकर मुस्कुरा लेना,\nकल के लिए उम्मीद जगा लेना।"},
{"id":176,"category":"रात","text":"रात गुजरती है तो सवेरा आता है,\nहर नया दिन नया संदेश लाता है।"},
{"id":177,"category":"रात","text":"सितारों से बातें करने का मन है,\nआज ख़्वाबों में खो जाने का मन है।"},
{"id":178,"category":"रात","text":"खिड़की से आती चाँदनी प्यारी लगती है,\nशांत रात हर सोच को न्यारी लगती है।"},
{"id":179,"category":"रात","text":"रात के बाद सुबह का उजाला होगा,\nहर नया सपना फिर निराला होगा।"},
{"id":180,"category":"रात","text":"नींद से पहले दुआ कर लेना,\nसबके लिए अच्छा सोचना और सो जाना।"},
{"id":181,"category":"परिवार","text":"माँ की दुआ में सबसे बड़ा सहारा है,\nउसके बिना हर आँगन अधूरा सा लगता है।"},
{"id":182,"category":"परिवार","text":"पिता की मेहनत का क़र्ज़ चुकाना आसान नहीं,\nउनके जैसा साया मिलना हर बार संभव नहीं।"},
{"id":183,"category":"परिवार","text":"घर की रौनक अपनों के साथ से होती है,\nहर खुशी परिवार की बात से होती है।"},
{"id":184,"category":"परिवार","text":"माँ की ममता का कोई मोल नहीं होता,\nउसके प्यार जैसा कोई अनमोल नहीं होता।"},
{"id":185,"category":"परिवार","text":"परिवार साथ हो तो हिम्मत बढ़ जाती है,\nमुश्किल घड़ी भी आसान बन जाती है।"},
{"id":186,"category":"परिवार","text":"बचपन की यादें घर में रह जाती हैं,\nअपनों की बातें उम्र भर मुस्कुराती हैं।"},
{"id":187,"category":"परिवार","text":"भाई का साथ अनमोल कहानी है,\nबहन की हँसी घर की निशानी है।"},
{"id":188,"category":"परिवार","text":"रिश्तों को वक़्त देना सीखो,\nअपनों की छोटी खुशी समझना सीखो।"},
{"id":189,"category":"परिवार","text":"घर बड़ा हो यह ज़रूरी नहीं होता,\nअपनों का प्यार हो तो सब पूरा होता।"},
{"id":190,"category":"परिवार","text":"बड़ों का आशीर्वाद सँभालकर रखना,\nछोटों के लिए दिल में प्यार रखना।"},
{"id":191,"category":"ज़िंदगी","text":"ज़िंदगी हर रोज़ नया पाठ पढ़ाती है,\nकभी हँसाती है तो कभी समझाती है।"},
{"id":192,"category":"ज़िंदगी","text":"हर मोड़ पर नया अनुभव मिलता है,\nचलते रहने से ही रास्ता मिलता है।"},
{"id":193,"category":"ज़िंदगी","text":"छोटी खुशियों को भी अपनाना सीखो,\nहर पल को मुस्कुराकर बिताना सीखो।"},
{"id":194,"category":"ज़िंदगी","text":"कल की चिंता में आज न खोना,\nजो पास है उसका शुक्र मनाना।"},
{"id":195,"category":"ज़िंदगी","text":"ज़िंदगी किताब जैसी खुलती जाती है,\nहर सुबह नई कहानी लिखती जाती है।"},
{"id":196,"category":"ज़िंदगी","text":"गलतियों से सीखकर आगे बढ़ना,\nहर दिन खुद को थोड़ा और गढ़ना।"},
{"id":197,"category":"ज़िंदगी","text":"कभी धूप तो कभी छाँव मिलती है,\nइसी का नाम ज़िंदगी की राह मिलती है।"},
{"id":198,"category":"ज़िंदगी","text":"अपने मन को उम्मीद से भर लेना,\nहर मुश्किल में धैर्य का हाथ धर लेना।"},
{"id":199,"category":"ज़िंदगी","text":"लोगों से नहीं, अपने कल से बेहतर बनो,\nहर दिन अपने सपनों के थोड़ा करीब चलो।"},
{"id":200,"category":"ज़िंदगी","text":"जो मिला है उसकी क़दर करना सीखो,\nहर पल में जीने का हुनर सीखो।"}
</escape>

<escape>
{"id":201,"category":"प्यार","text":"तेरी यादों का मौसम बड़ा सुहाना है,\nदिल को आज भी तेरा ख़याल आना है।"},
{"id":202,"category":"प्यार","text":"तेरी बातों में अपनापन नज़र आता है,\nहर लम्हा कुछ ख़ास बन जाता है।"},
{"id":203,"category":"प्यार","text":"दिल की धड़कन में एक गीत सा रहता है,\nतेरा ख़याल मेरे करीब सा रहता है।"},
{"id":204,"category":"प्यार","text":"साथ चलने का वादा निभाना प्यारा है,\nरिश्तों में भरोसा ही सबसे न्यारा है।"},
{"id":205,"category":"प्यार","text":"तेरे आने से मौसम मुस्कुराने लगा,\nदिल फिर से नए सपने सजाने लगा।"},
{"id":206,"category":"प्यार","text":"तेरी हँसी में एक अलग बात है,\nजैसे सुबह की पहली मुलाक़ात है।"},
{"id":207,"category":"प्यार","text":"प्यार में इज़्ज़त सबसे पहले आती है,\nतभी तो मोहब्बत उम्र भर निभाती है।"},
{"id":208,"category":"प्यार","text":"तू साथ हो तो हर पल ख़ास लगे,\nतेरे बिना भी तेरा एहसास पास लगे।"},
{"id":209,"category":"प्यार","text":"नाराज़गी हो तो बात से मिटा लेना,\nरिश्ते को अहंकार से बचा लेना।"},
{"id":210,"category":"प्यार","text":"दिल की दुनिया में उजाला सा रहता है,\nजब किसी अपने का ख़याल रहता है।"},
{"id":211,"category":"दर्द","text":"कभी-कभी यादें आवाज़ लगाती हैं,\nपुरानी बातें आँखों में उतर आती हैं।"},
{"id":212,"category":"दर्द","text":"जो बात दिल में थी कह न सके,\nकुछ लम्हे थे जिन्हें हम सह न सके।"},
{"id":213,"category":"दर्द","text":"वक़्त ने कई चेहरे पहचानना सिखाया,\nहर मुस्कान पर भरोसा न करना सिखाया।"},
{"id":214,"category":"दर्द","text":"उम्मीदों का टूटना आसान नहीं होता,\nहर दर्द किसी को बयान नहीं होता।"},
{"id":215,"category":"दर्द","text":"कुछ रास्ते अकेले तय करने पड़ते हैं,\nकुछ जवाब ख़ुद ही समझने पड़ते हैं।"},
{"id":216,"category":"दर्द","text":"किसी की कमी का एहसास रह जाता है,\nदिल में एक खाली सा स्थान रह जाता है।"},
{"id":217,"category":"दर्द","text":"हर बीता दिन कुछ सिखा जाता है,\nकभी हँसाकर तो कभी समझा जाता है।"},
{"id":218,"category":"दर्द","text":"कहने को बहुत कुछ बाकी रह गया,\nएक छोटा सा लम्हा कहानी बन गया।"},
{"id":219,"category":"दर्द","text":"कभी ख़ामोशी में भी सुकून मिलता है,\nजब दिल को खुद से मिलने का वक़्त मिलता है।"},
{"id":220,"category":"दर्द","text":"जो अपना था वह यादों में रह गया,\nएक पुराना मौसम पीछे रह गया।"},
{"id":221,"category":"दोस्ती","text":"दोस्ती का दीप हमेशा जलाए रखना,\nअपनों के लिए दिल में जगह बनाए रखना।"},
{"id":222,"category":"दोस्ती","text":"साथ हँसने का मज़ा ही कुछ और है,\nदोस्तों के संग हर दिन का दौर है।"},
{"id":223,"category":"दोस्ती","text":"यारों की बातें दिल को भाती हैं,\nपुरानी यादें फिर हँसी ले आती हैं।"},
{"id":224,"category":"दोस्ती","text":"दोस्त वही जो हौसला बढ़ाए,\nगलती हो तो प्यार से समझाए।"},
{"id":225,"category":"दोस्ती","text":"न कोई दिखावा न कोई दीवार,\nसच्ची दोस्ती में बस होता है प्यार।"},
{"id":226,"category":"दोस्ती","text":"यारी का रिश्ता दिल से निभाना,\nदोस्त की ख़ुशी में खुश हो जाना।"},
{"id":227,"category":"दोस्ती","text":"दोस्तों के बिना महफ़िल अधूरी है,\nउनकी हँसी ही सबसे ज़रूरी है।"},
{"id":228,"category":"दोस्ती","text":"मुसीबत में जो हाथ बढ़ाता है,\nवही सच्चा दोस्त कहलाता है।"},
{"id":229,"category":"दोस्ती","text":"कभी चाय पर तो कभी सफ़र में मिलना,\nदोस्ती का सिलसिला यूँ ही चलता रहना।"},
{"id":230,"category":"दोस्ती","text":"पुराने यारों को भूलना मत कभी,\nयादों की दौलत कम होती नहीं कभी।"},
{"id":231,"category":"एटीट्यूड","text":"हम अपनी मेहनत पर यक़ीन रखते हैं,\nइसलिए हर दिन नया सपना चुनते हैं।"},
{"id":232,"category":"एटीट्यूड","text":"बातों से नहीं, काम से पहचान होगी,\nमेहनत ही हमारी सबसे बड़ी शान होगी।"},
{"id":233,"category":"एटीट्यूड","text":"किसी की नकल करना हमें आता नहीं,\nअपना रास्ता चुनने से घबराते नहीं।"},
{"id":234,"category":"एटीट्यूड","text":"हमारे इरादे साफ़ और मजबूत हैं,\nइसीलिए सपने भी हमारे खूब हैं।"},
{"id":235,"category":"एटीट्यूड","text":"इज़्ज़त दो तो इज़्ज़त पाओगे,\nअच्छे व्यवहार से दिल जीत जाओगे।"},
{"id":236,"category":"एटीट्यूड","text":"अपनी कमियों को सुधारते रहते हैं,\nहर दिन नया हुनर निखारते रहते हैं।"},
{"id":237,"category":"एटीट्यूड","text":"हमारे लिए उसूल सबसे ख़ास हैं,\nइन्हीं से बनती अपनी पहचान है।"},
{"id":238,"category":"एटीट्यूड","text":"शांत रहना हमारी आदत है,\nसच्चाई से चलना हमारी ताक़त है।"},
{"id":239,"category":"एटीट्यूड","text":"मंज़िल की ओर नज़र टिकाए रखते हैं,\nहर चुनौती को सीख बनाए रखते हैं।"},
{"id":240,"category":"एटीट्यूड","text":"खुद की राह पर भरोसा रखते हैं,\nहम अपनी कोशिशों से उम्मीद रखते हैं।"},
{"id":241,"category":"मोटिवेशन","text":"हर सुबह एक नया अवसर लाती है,\nमेहनत करने की प्रेरणा जगाती है।"},
{"id":242,"category":"मोटिवेशन","text":"कदम छोटे हों तो भी चलते रहो,\nअपने लक्ष्य से रिश्ता बनाए रखो।"},
{"id":243,"category":"मोटिवेशन","text":"सीखने वाला कभी पीछे नहीं रहता,\nमेहनत का फल एक दिन ज़रूर मिलता।"},
{"id":244,"category":"मोटिवेशन","text":"आज की लगन कल की पहचान बनेगी,\nतुम्हारी मेहनत ही तुम्हारी उड़ान बनेगी।"},
{"id":245,"category":"मोटिवेशन","text":"समस्याएँ आएँ तो रास्ता खोजो,\nअपने भीतर का विश्वास रोज़ संजोओ।"},
{"id":246,"category":"मोटिवेशन","text":"सपनों को पाने का जुनून रखो,\nहर दिन नया सीखने का सुकून रखो।"},
{"id":247,"category":"मोटिवेशन","text":"जो कोशिश से रिश्ता जोड़ लेते हैं,\nवही अपने सपनों को मोड़ देते हैं।"},
{"id":248,"category":"मोटिवेशन","text":"धैर्य रखो, समय बदलता रहता है,\nमेहनती इंसान आगे बढ़ता रहता है।"},
{"id":249,"category":"मोटिवेशन","text":"अपनी मंज़िल का पता याद रखना,\nहर दिन अपने लक्ष्य को आबाद रखना।"},
{"id":250,"category":"मोटिवेशन","text":"खुद पर भरोसा सबसे बड़ी ताक़त है,\nलगातार मेहनत ही असली दौलत है।"},
{"id":251,"category":"भक्ति","text":"ईश्वर का नाम मन को शांति देता है,\nहर अच्छे कर्म को नई पहचान देता है।"},
{"id":252,"category":"भक्ति","text":"मन में करुणा का भाव जगाना,\nहर जीव के साथ प्रेम निभाना।"},
{"id":253,"category":"भक्ति","text":"प्रभु से बस इतनी विनती करते हैं,\nसबके जीवन में खुशियाँ भरते हैं।"},
{"id":254,"category":"भक्ति","text":"सच्चे कर्मों से राह बनती है,\nश्रद्धा से मन की शक्ति बढ़ती है।"},
{"id":255,"category":"भक्ति","text":"दूसरों के काम आना सीखो,\nसेवा में सच्चा सुख पाना सीखो।"},
{"id":256,"category":"भक्ति","text":"मन साफ़ हो तो प्रार्थना सुंदर लगती है,\nदया से दुनिया भी बेहतर लगती है।"},
{"id":257,"category":"भक्ति","text":"हर सुबह प्रभु का धन्यवाद करो,\nअच्छे कर्मों से दिन की शुरुआत करो।"},
{"id":258,"category":"भक्ति","text":"विनम्रता से जीवन सज जाता है,\nप्रेम से हर मन जुड़ जाता है।"},
{"id":259,"category":"भक्ति","text":"दया और सच्चाई का साथ निभाना,\nयही जीवन का सुंदर ख़ज़ाना।"},
{"id":260,"category":"भक्ति","text":"भक्ति केवल शब्दों में नहीं होती,\nअच्छे कर्मों में भी दिखाई देती।"},
{"id":261,"category":"देशभक्ति","text":"तिरंगे की शान दिल में बसाए रखना,\nभारत की एकता को बनाए रखना।"},
{"id":262,"category":"देशभक्ति","text":"हम सब मिलकर देश सजाएँ,\nज्ञान और मेहनत से आगे बढ़ाएँ।"},
{"id":263,"category":"देशभक्ति","text":"हर भाषा का सम्मान हमारा काम है,\nएकता ही भारत की पहचान है।"},
{"id":264,"category":"देशभक्ति","text":"धरती की खुशबू मन में रहती है,\nदेश की याद हर पल कहती है।"},
{"id":265,"category":"देशभक्ति","text":"देश के लिए ईमानदारी से काम करें,\nअपने कर्तव्य का सम्मान करें।"},
{"id":266,"category":"देशभक्ति","text":"नदियों, पर्वतों और खेतों की शान,\nइनसे सुंदर अपना हिंदुस्तान।"},
{"id":267,"category":"देशभक्ति","text":"शिक्षा से हर अँधेरा मिटाएँ,\nहर बच्चे को आगे बढ़ाएँ।"},
{"id":268,"category":"देशभक्ति","text":"मिलजुल कर त्योहार मनाते हैं,\nइसी से देश के रंग सजाते हैं।"},
{"id":269,"category":"देशभक्ति","text":"मेहनत से भारत का नाम बढ़ाएँ,\nहर क्षेत्र में नई मिसाल बनाएँ।"},
{"id":270,"category":"देशभक्ति","text":"एकता का संदेश फैलाते चलो,\nदेश के लिए अच्छे काम करते चलो।"},
{"id":271,"category":"रात","text":"रात की चुप्पी में सपने पलते हैं,\nसुबह के इरादे दिल में ढलते हैं।"},
{"id":272,"category":"रात","text":"चाँद की रोशनी मन को भाती है,\nधीरे-धीरे थकान मिटाती है।"},
{"id":273,"category":"रात","text":"तारों के नीचे ख़्वाब सजाएँ,\nकल के लिए नई राह बनाएँ।"},
{"id":274,"category":"रात","text":"रात का सन्नाटा कुछ कहता है,\nमन अपने आप से बातें करता है।"},
{"id":275,"category":"रात","text":"दिन ढला तो आराम का वक़्त आया,\nरात ने सपनों का संदेश सुनाया।"},
{"id":276,"category":"रात","text":"चाँदनी में एक नूर सा छाया है,\nआज मौसम भी मुस्कुराया है।"},
{"id":277,"category":"रात","text":"हर रात के बाद सवेरा आता है,\nहर सपना नई उम्मीद जगाता है।"},
{"id":278,"category":"रात","text":"नीले आसमान में तारे चमकते हैं,\nख़ामोश लम्हे भी कुछ कहते हैं।"},
{"id":279,"category":"रात","text":"रात को सुकून से गुज़र जाने दो,\nसुबह को नई शुरुआत बन जाने दो।"},
{"id":280,"category":"रात","text":"आँखों में अच्छे सपने सजाना,\nकल उठकर उन्हें पूरा कर जाना।"},
{"id":281,"category":"प्रकृति","text":"फूलों की खुशबू हवा में घुल जाती है,\nसुबह की धूप नई उम्मीद जगाती है।"},
{"id":282,"category":"प्रकृति","text":"बारिश की बूँदें धरती को सजाती हैं,\nसूखी डालों पर हरियाली लाती हैं।"},
{"id":283,"category":"प्रकृति","text":"पहाड़ों की ख़ामोशी बहुत कुछ कहती है,\nनदी की धारा आगे बढ़ना सिखाती है।"},
{"id":284,"category":"प्रकृति","text":"पत्तों पर ओस का मोती चमकता है,\nसुबह का हर दृश्य मन को महकता है।"},
{"id":285,"category":"प्रकृति","text":"खुला आसमान सपने दिखाता है,\nउड़ता परिंदा आज़ादी सिखाता है।"},
{"id":286,"category":"प्रकृति","text":"पेड़ों की छाँव बड़ा उपहार है,\nधरती का हर कोना अनमोल संसार है।"},
{"id":287,"category":"प्रकृति","text":"सूरज की किरणें संदेश सुनाती हैं,\nअँधेरे के बाद रोशनी आती है।"},
{"id":288,"category":"प्रकृति","text":"नदी की लहरें गुनगुनाती हैं,\nचलते रहने की राह बताती हैं।"},
{"id":289,"category":"प्रकृति","text":"मिट्टी की खुशबू दिल को छू जाती है,\nबारिश हर याद ताज़ा कर जाती है।"},
{"id":290,"category":"प्रकृति","text":"प्रकृति का हर रंग निराला है,\nइसका संरक्षण सबसे बड़ा रखवाला है।"},
{"id":291,"category":"ज़िंदगी","text":"हर दिन एक नई कहानी लिखता है,\nइंसान अपने कर्मों से नाम लिखता है।"},
{"id":292,"category":"ज़िंदगी","text":"खुशी बाँटो तो खुशी बढ़ जाती है,\nमुस्कान से मुश्किल घट जाती है।"},
{"id":293,"category":"ज़िंदगी","text":"बदलते वक़्त से सीखते जाना,\nहर अनुभव को अपना बनाना।"},
{"id":294,"category":"ज़िंदगी","text":"जो पल पास है उसे जी लेना,\nकल की चिंता को थोड़ा कम कर लेना।"},
{"id":295,"category":"ज़िंदगी","text":"रिश्तों में भरोसा बनाए रखना,\nअपने शब्दों का मान बनाए रखना।"},
{"id":296,"category":"ज़िंदगी","text":"हर इंसान से कुछ सीख मिलती है,\nहर मुलाक़ात नई राह खोलती है।"},
{"id":297,"category":"ज़िंदगी","text":"खुद को समझना भी ज़रूरी है,\nमन की शांति सबसे ज़रूरी है।"},
{"id":298,"category":"ज़िंदगी","text":"सादगी में भी सुंदरता होती है,\nसच्चाई में बड़ी ताक़त होती है।"},
{"id":299,"category":"ज़िंदगी","text":"अच्छे विचारों से दिन सजाओ,\nछोटी खुशियों को दिल से अपनाओ।"},
{"id":300,"category":"ज़िंदगी","text":"हर मोड़ पर सब्र बनाए रखना,\nउम्मीद का दीप जलाए रखना।"}
</escape>

<escape>
{"id":301,"category":"प्यार","text":"तेरे साथ की छोटी बातें याद रहती हैं,\nदिल में मीठी मुलाक़ातें आबाद रहती हैं।"},
{"id":302,"category":"प्यार","text":"मोहब्बत में सम्मान का होना ज़रूरी है,\nतभी हर कहानी खूबसूरत और पूरी है।"},
{"id":303,"category":"प्यार","text":"तेरी हँसी से दिन सँवर जाता है,\nदिल का मौसम भी निखर जाता है।"},
{"id":304,"category":"प्यार","text":"कभी चाँदनी, कभी सुबह की किरण हो तुम,\nमेरे ख़यालों का प्यारा सा सुकून हो तुम।"},
{"id":305,"category":"प्यार","text":"रिश्ते को समय और विश्वास चाहिए,\nमोहब्बत को बस सच्चा एहसास चाहिए।"},
{"id":306,"category":"प्यार","text":"तेरी यादों से शाम रंगीन हो जाती है,\nहर साधारण बात भी हसीन हो जाती है।"},
{"id":307,"category":"प्यार","text":"नाराज़ दिल को प्यार से मना लेना,\nअपनी बातों में थोड़ा अपनापन मिला लेना।"},
{"id":308,"category":"प्यार","text":"सच्चा प्यार कभी दबाव नहीं बनाता,\nवह इज़्ज़त देकर रिश्ता निभाता।"},
{"id":309,"category":"प्यार","text":"तेरे संग हँसना अच्छा लगता है,\nहर छोटा लम्हा सच्चा लगता है।"},
{"id":310,"category":"प्यार","text":"दिल से निकली बात दिल तक जाती है,\nसच्ची मोहब्बत हर मुश्किल सह जाती है।"},
{"id":311,"category":"दर्द","text":"कुछ लम्हे लौटकर नहीं आते,\nपर दिल से कभी दूर नहीं जाते।"},
{"id":312,"category":"दर्द","text":"ख़ामोश रहकर भी बहुत कुछ कह जाते हैं,\nकुछ लोग यादों में घर कर जाते हैं।"},
{"id":313,"category":"दर्द","text":"टूटे सपनों से भी सीख मिलती है,\nनई राह की एक तस्वीर मिलती है।"},
{"id":314,"category":"दर्द","text":"हर दूरी का मतलब जुदाई नहीं होता,\nहर इंतज़ार बेवफ़ाई नहीं होता।"},
{"id":315,"category":"दर्द","text":"कुछ यादें मौसम बनकर आती हैं,\nपुरानी गलियों में फिर ले जाती हैं।"},
{"id":316,"category":"दर्द","text":"कभी अपने भी समझ नहीं पाते,\nदिल के सारे राज़ कहे नहीं जाते।"},
{"id":317,"category":"दर्द","text":"समय ने हमें धैर्य सिखाया है,\nहर अनुभव ने कुछ समझाया है।"},
{"id":318,"category":"दर्द","text":"जो बीत गया उसे जाने देना,\nखुद को फिर से मुस्कुराने देना।"},
{"id":319,"category":"दर्द","text":"कुछ अधूरे ख़्वाब भी प्यारे होते हैं,\nयादों के पन्नों में सँवारे होते हैं।"},
{"id":320,"category":"दर्द","text":"कभी दिल को थोड़ा आराम चाहिए,\nहर सवाल का तुरंत जवाब नहीं चाहिए।"},
{"id":321,"category":"दोस्ती","text":"दोस्ती में भरोसा सबसे बड़ी बात है,\nयही हर रिश्ते की असली सौगात है।"},
{"id":322,"category":"दोस्ती","text":"यारों के संग सफ़र आसान लगता है,\nहर नया रास्ता मेहमान लगता है।"},
{"id":323,"category":"दोस्ती","text":"दोस्तों की हँसी घर तक जाती है,\nथकी हुई शाम भी खिल जाती है।"},
{"id":324,"category":"दोस्ती","text":"जो सच कहकर भी साथ निभाए,\nवही दोस्त दिल में जगह बनाए।"},
{"id":325,"category":"दोस्ती","text":"मिलना कम हो तो क्या हुआ,\nदिल में अपनापन कम नहीं हुआ।"},
{"id":326,"category":"दोस्ती","text":"यारी में छोटी बात बड़ी नहीं होती,\nसच्ची दोस्ती कभी खड़ी नहीं होती।"},
{"id":327,"category":"दोस्ती","text":"दोस्त की तरक्की पर खुश होना,\nयारी के रिश्ते को और मज़बूत करना।"},
{"id":328,"category":"दोस्ती","text":"एक कप चाय और यारों की बात,\nयादगार बन जाती है पूरी रात।"},
{"id":329,"category":"दोस्ती","text":"मुश्किल दिनों में जो हौसला दे जाए,\nवही दोस्त जीवन भर याद आए।"},
{"id":330,"category":"दोस्ती","text":"दोस्ती में दिल का साफ़ होना चाहिए,\nरिश्ता हर हाल में ख़ास होना चाहिए।"},
{"id":331,"category":"एटीट्यूड","text":"हमारी सोच ही हमारी उड़ान है,\nमेहनत ही हमारी असली पहचान है।"},
{"id":332,"category":"एटीट्यूड","text":"खुद पर भरोसा रखना जानते हैं,\nमुश्किलों में भी मुस्कुराना जानते हैं।"},
{"id":333,"category":"एटीट्यूड","text":"हम बातों से नहीं काम से चलते हैं,\nअपने सपनों के नाम से पलते हैं।"},
{"id":334,"category":"एटीट्यूड","text":"इज़्ज़त हर इंसान को देना जानते हैं,\nअपने आत्मसम्मान को भी पहचानते हैं।"},
{"id":335,"category":"एटीट्यूड","text":"दिखावे की दुनिया से दूर रहते हैं,\nहम अपने काम में मशगूल रहते हैं।"},
{"id":336,"category":"एटीट्यूड","text":"इरादे मजबूत हों तो राह बनती है,\nमेहनत से ही पहचान बनती है।"},
{"id":337,"category":"एटीट्यूड","text":"हम अपने उसूलों से समझौता नहीं करते,\nसच्चाई के रास्ते से किनारा नहीं करते।"},
{"id":338,"category":"एटीट्यूड","text":"नज़र लक्ष्य पर और कदम ज़मीन पर,\nयही अंदाज़ है हमारे जीवन पर।"},
{"id":339,"category":"एटीट्यूड","text":"जो सीखने से कभी घबराते नहीं,\nवही आगे बढ़ने से रुक पाते नहीं।"},
{"id":340,"category":"एटीट्यूड","text":"अपनी पहचान खुद बनानी है,\nमेहनत से नई कहानी लिख जानी है।"},
{"id":341,"category":"मोटिवेशन","text":"एक दिन में सब कुछ नहीं बदलता,\nलगातार प्रयास कभी खाली नहीं जाता।"},
{"id":342,"category":"मोटिवेशन","text":"जो आज सीखोगे वही कल काम आएगा,\nतुम्हारा हुनर तुम्हें आगे ले जाएगा।"},
{"id":343,"category":"मोटिवेशन","text":"हार से नहीं, रुक जाने से डरना,\nहर नए प्रयास के लिए तैयार रहना।"},
{"id":344,"category":"मोटिवेशन","text":"लक्ष्य बड़ा है तो तैयारी भी बड़ी करो,\nहर दिन अपने हुनर में बढ़ोतरी करो।"},
{"id":345,"category":"मोटिवेशन","text":"वक़्त का सही उपयोग करना सीखो,\nअपने सपनों को सच करना सीखो।"},
{"id":346,"category":"मोटिवेशन","text":"मेहनत की राह में सब्र रखना,\nखुद पर भरोसे का दीप रखना।"},
{"id":347,"category":"मोटिवेशन","text":"किताबों से ज्ञान और अनुभव से समझ लो,\nहर दिन कुछ नया सीखकर आगे बढ़ लो।"},
{"id":348,"category":"मोटिवेशन","text":"जो अपने लक्ष्य को याद रखता है,\nवह मुश्किलों में भी प्रयास करता है।"},
{"id":349,"category":"मोटिवेशन","text":"आज की मेहनत कल मुस्कान लाएगी,\nलगन तुम्हारी पहचान बनाएगी।"},
{"id":350,"category":"मोटिवेशन","text":"खुद से किया वादा निभाना सीखो,\nअपने सपनों को अपनाना सीखो।"},
{"id":351,"category":"भक्ति","text":"मन में विश्वास का दीप जलाओ,\nसबके लिए मंगल की कामना लाओ।"},
{"id":352,"category":"भक्ति","text":"ईश्वर की बनाई दुनिया प्यारी है,\nहर जीव की अपनी ज़िम्मेदारी है।"},
{"id":353,"category":"भक्ति","text":"प्रेम से बड़ा कोई उपदेश नहीं,\nदया से बड़ा कोई संदेश नहीं।"},
{"id":354,"category":"भक्ति","text":"नेकी की राह पर कदम बढ़ाना,\nकिसी ज़रूरतमंद के काम आना।"},
{"id":355,"category":"भक्ति","text":"सच्चे मन से जो सेवा करता है,\nवह अपने जीवन को सुंदर करता है।"},
{"id":356,"category":"भक्ति","text":"प्रार्थना में सबके लिए सुख माँगना,\nअपने मन में कभी घमंड न पालना।"},
{"id":357,"category":"भक्ति","text":"हर दिन को उपहार समझना,\nअच्छे कर्मों से जीवन सजाना।"},
{"id":358,"category":"भक्ति","text":"धर्म हमें इंसानियत सिखाता है,\nप्रेम हर दिल को पास लाता है।"},
{"id":359,"category":"भक्ति","text":"मन में शांति और वाणी में मिठास हो,\nहर कदम पर नेकी का एहसास हो।"},
{"id":360,"category":"भक्ति","text":"सबके सुख की कामना करना,\nयही है सुंदर जीवन का गहना।"},
{"id":361,"category":"देशभक्ति","text":"भारत की पहचान इसकी विविधता है,\nहर दिल में बसती एकता की क्षमता है।"},
{"id":362,"category":"देशभक्ति","text":"तिरंगा आसमान में लहराता रहे,\nहर दिल में देशप्रेम जगाता रहे।"},
{"id":363,"category":"देशभक्ति","text":"सीख और विज्ञान से आगे बढ़ें,\nदेश के विकास में मिलकर जुड़ें।"},
{"id":364,"category":"देशभक्ति","text":"हर खेत में मेहनत का सम्मान हो,\nहर बच्चे के हाथ में ज्ञान हो।"},
{"id":365,"category":"देशभक्ति","text":"देश की सेवा हर रूप में होती है,\nईमानदार मेहनत भी देशभक्ति होती है।"},
{"id":366,"category":"देशभक्ति","text":"एकता का रिश्ता बनाए रखना,\nआपसी सम्मान हमेशा निभाए रखना।"},
{"id":367,"category":"देशभक्ति","text":"अपनी भाषा और संस्कृति पर प्यार रखें,\nदूसरों की परंपराओं का भी सम्मान रखें।"},
{"id":368,"category":"देशभक्ति","text":"नए विचारों से देश सजाएँ,\nमिलकर उज्ज्वल कल बनाएँ।"},
{"id":369,"category":"देशभक्ति","text":"देश की प्रगति में हाथ बँटाएँ,\nज्ञान और मेहनत का दीप जलाएँ।"},
{"id":370,"category":"देशभक्ति","text":"भारत की मिट्टी का मान बढ़ाएँ,\nसच्चे नागरिक बनकर दिखाएँ।"},
{"id":371,"category":"रात","text":"चाँद की चुप्पी में कहानी है,\nतारों की आँखों में रवानी है।"},
{"id":372,"category":"रात","text":"रात की ठंडी हवा संदेश लाती है,\nथके मन को थोड़ा आराम दिलाती है।"},
{"id":373,"category":"रात","text":"सितारों से सजी ये रात निराली है,\nहर ख़्वाब की अपनी एक लाली है।"},
{"id":374,"category":"रात","text":"चाँदनी में मन को सुकून मिलता है,\nहर ख़ामोश पल में जुनून मिलता है।"},
{"id":375,"category":"रात","text":"रात के बाद सुबह ज़रूर आएगी,\nनई किरण नई उम्मीद जगाएगी।"},
{"id":376,"category":"रात","text":"खिड़की पर चाँद मुस्कुराता है,\nमन को मीठा सपना दिखाता है।"},
{"id":377,"category":"रात","text":"दिन की बातें अब जाने दो,\nरात को मीठे सपने सजाने दो।"},
{"id":378,"category":"रात","text":"नीले गगन में तारे जगमगाते हैं,\nख़्वाब नए मन में मुस्कुराते हैं।"},
{"id":379,"category":"रात","text":"शांत रात का अपना अंदाज़ है,\nहर तारे में उम्मीद का राज़ है।"},
{"id":380,"category":"रात","text":"रात कहती है आराम कर लेना,\nकल फिर नए सफ़र पर चल देना।"},
{"id":381,"category":"परिवार","text":"माँ की आवाज़ में अपनापन रहता है,\nउसकी दुआ में जीवन का सुकून रहता है।"},
{"id":382,"category":"परिवार","text":"पिता की सीख रास्ता दिखाती है,\nउनकी मेहनत जीवन बनाती है।"},
{"id":383,"category":"परिवार","text":"बहन की हँसी घर को सजाती है,\nभाई की यारी याद बन जाती है।"},
{"id":384,"category":"परिवार","text":"अपनों के संग त्योहार मनाना,\nछोटी खुशियों को बड़ा बनाना।"},
{"id":385,"category":"परिवार","text":"परिवार का साथ अनमोल होता है,\nहर मुश्किल में यह मजबूत ढाल होता है।"},
{"id":386,"category":"परिवार","text":"बचपन के आँगन की बात निराली है,\nअपनों की याद सबसे प्यारी है।"},
{"id":387,"category":"परिवार","text":"घर में बड़ों का सम्मान बनाए रखना,\nछोटों के सपनों का ध्यान रखना।"},
{"id":388,"category":"परिवार","text":"माँ की रसोई की खुशबू याद आती है,\nघर की हर बात दिल को भाती है।"},
{"id":389,"category":"परिवार","text":"रिश्तों में समय लगाते रहना,\nअपनों को अपना बताते रहना।"},
{"id":390,"category":"परिवार","text":"परिवार से बढ़कर दौलत क्या होगी,\nअपनों की हँसी से सुंदर दुनिया क्या होगी।"},
{"id":391,"category":"प्रकृति","text":"सुबह की किरण जब धरती पर आती है,\nहर सूनी डाली फिर मुस्कुराती है।"},
{"id":392,"category":"प्रकृति","text":"बादल बरसें तो मिट्टी महक जाती है,\nधरती की प्यास भी बुझ जाती है।"},
{"id":393,"category":"प्रकृति","text":"पर्वत खड़े रहकर धैर्य सिखाते हैं,\nनदियाँ चलकर आगे बढ़ना बताती हैं।"},
{"id":394,"category":"प्रकृति","text":"फूलों की रंगत मन को भाती है,\nतितली नई कहानी सुनाती है।"},
{"id":395,"category":"प्रकृति","text":"पेड़ लगाओ, हरियाली बढ़ाओ,\nआने वाली पीढ़ी का कल सजाओ।"},
{"id":396,"category":"प्रकृति","text":"समुद्र की लहरें गीत सुनाती हैं,\nकिनारों पर नई छाप छोड़ जाती हैं।"},
{"id":397,"category":"प्रकृति","text":"सूरज ढले तो रंग बिखर जाते हैं,\nआसमान में सपने उतर आते हैं।"},
{"id":398,"category":"प्रकृति","text":"चिड़ियों की चहक सुबह जगाती है,\nप्रकृति जीवन का गीत सुनाती है।"},
{"id":399,"category":"प्रकृति","text":"धरती का हर मौसम प्यारा है,\nप्रकृति जीवन का सहारा है।"},
{"id":400,"category":"प्रकृति","text":"हरियाली को अपना मान बनाओ,\nप्रकृति को स्वच्छ और सुंदर बनाओ।"}
</escape>

<escape>
{"id":401,"category":"प्यार","text":"तेरी बातों में एक मिठास रहती है,\nदिल में तेरी प्यारी सी आस रहती है।"},
{"id":402,"category":"प्यार","text":"प्यार का रिश्ता विश्वास से खिलता है,\nसम्मान मिले तो हर दिन सँवरता है।"},
{"id":403,"category":"प्यार","text":"तेरी याद सुबह की किरण बन जाती है,\nथकी हुई शाम भी मुस्कुरा जाती है।"},
{"id":404,"category":"प्यार","text":"साथ हो तो सफ़र आसान लगता है,\nहर छोटा पल भी महान लगता है।"},
{"id":405,"category":"प्यार","text":"दिल में सच्चाई और बातों में प्यार हो,\nरिश्ता ऐसा हो जिसमें खुला संसार हो।"},
{"id":406,"category":"प्यार","text":"तेरे संग हँसी का मौसम आता है,\nहर दिन एक नया रंग लाता है।"},
{"id":407,"category":"प्यार","text":"मोहब्बत में भरोसा सबसे प्यारा है,\nयही हर रिश्ते का असली सहारा है।"},
{"id":408,"category":"प्यार","text":"किसी की ख़ुशी का कारण बन जाना,\nप्यार का सुंदर मतलब समझ जाना।"},
{"id":409,"category":"प्यार","text":"तेरी मुस्कान का जादू निराला है,\nदिल ने इसे प्यार से सँभाला है।"},
{"id":410,"category":"प्यार","text":"रिश्तों में सच्चे दिल से बात करना,\nएक-दूजे के सपनों का सम्मान करना।"},
{"id":411,"category":"दर्द","text":"बीते लम्हों की तस्वीर रह जाती है,\nकुछ बातें दिल के पास रह जाती हैं।"},
{"id":412,"category":"दर्द","text":"कभी रास्ते भी बदलने पड़ते हैं,\nअपने सपनों के लिए आगे बढ़ना पड़ता है।"},
{"id":413,"category":"दर्द","text":"हर किसी को अपनी कहानी मत बताना,\nपहले खुद को समझना और फिर मुस्कुराना।"},
{"id":414,"category":"दर्द","text":"यादों की बारिश जब आती है,\nपुरानी बात दिल को छू जाती है।"},
{"id":415,"category":"दर्द","text":"कुछ रिश्ते सीख देकर चले जाते हैं,\nकुछ चेहरे याद बनकर रह जाते हैं।"},
{"id":416,"category":"दर्द","text":"मन को कभी आराम भी देना चाहिए,\nखुद से भी प्यार करना चाहिए।"},
{"id":417,"category":"दर्द","text":"जो बीत गया वह कहानी बन गया,\nहर अनुभव एक निशानी बन गया।"},
{"id":418,"category":"दर्द","text":"ख़ामोशी का भी अपना बयान होता है,\nहर एहसास का अलग जहान होता है।"},
{"id":419,"category":"दर्द","text":"वक़्त के साथ नज़र बदल जाती है,\nकई पुरानी बातें समझ आ जाती हैं।"},
{"id":420,"category":"दर्द","text":"यादों को मुस्कान से सँभालना,\nबीते कल से सीख लेकर आगे बढ़ना।"},
{"id":421,"category":"दोस्ती","text":"दोस्तों का साथ त्योहार जैसा है,\nहर दिन का रंग बहार जैसा है।"},
{"id":422,"category":"दोस्ती","text":"यारों की महफ़िल में बात बन जाती है,\nसाधारण शाम भी ख़ास बन जाती है।"},
{"id":423,"category":"दोस्ती","text":"दोस्ती में सच बोलना ज़रूरी है,\nरिश्ते की नींव मजबूत होना ज़रूरी है।"},
{"id":424,"category":"दोस्ती","text":"एक दोस्त जो हँसना सिखा जाए,\nमुश्किल दिनों में राह दिखा जाए।"},
{"id":425,"category":"दोस्ती","text":"सच्चे दोस्त की पहचान निराली है,\nउसकी मौजूदगी हर घड़ी खुशहाली है।"},
{"id":426,"category":"दोस्ती","text":"यारी में यादों का ख़ज़ाना है,\nहर दोस्त एक प्यारा अफ़साना है।"},
{"id":427,"category":"दोस्ती","text":"दोस्त के सपनों में साथ निभाना,\nउसकी सफलता पर दिल से मुस्कुराना।"},
{"id":428,"category":"दोस्ती","text":"दूर रहकर भी दिल करीब रहते हैं,\nसच्चे दोस्त हमेशा अज़ीज़ रहते हैं।"},
{"id":429,"category":"दोस्ती","text":"बातें कम हों तो भी प्यार कम नहीं होता,\nसच्चे दोस्त का इंतज़ार कम नहीं होता।"},
{"id":430,"category":"दोस्ती","text":"दोस्ती का वादा दिल से निभाएँ,\nएक-दूजे के अच्छे दिन मनाएँ।"},
{"id":431,"category":"एटीट्यूड","text":"अपने सपनों का सम्मान करते हैं,\nहर दिन मेहनत के नाम करते हैं।"},
{"id":432,"category":"एटीट्यूड","text":"नज़रिया साफ़ और इरादे मजबूत हैं,\nइसीलिए हमारे सपने भी खूब हैं।"},
{"id":433,"category":"एटीट्यूड","text":"हम अपनी पहचान खुद लिखेंगे,\nमेहनत के पन्नों पर आगे बढ़ेंगे।"},
{"id":434,"category":"एटीट्यूड","text":"सादगी से रहना हमें पसंद है,\nअपने उसूलों पर चलना हमारा अंदाज़ है।"},
{"id":435,"category":"एटीट्यूड","text":"कामयाबी का कोई शॉर्टकट नहीं होता,\nमेहनत करने वाला कभी छोटा नहीं होता।"},
{"id":436,"category":"एटीट्यूड","text":"अपनी सोच को ऊँचा रखते हैं,\nपाँव हमेशा ज़मीन पर रखते हैं।"},
{"id":437,"category":"एटीट्यूड","text":"हम वक़्त के साथ खुद को ढालते हैं,\nहर चुनौती से नया हुनर निकालते हैं।"},
{"id":438,"category":"एटीट्यूड","text":"दूसरों की इज़्ज़त करना जानते हैं,\nअपनी सीमाएँ भी पहचानते हैं।"},
{"id":439,"category":"एटीट्यूड","text":"नाम कमाने का सपना रखते हैं,\nकाम को सबसे ऊपर रखते हैं।"},
{"id":440,"category":"एटीट्यूड","text":"हमारी राह हमारी ज़िम्मेदारी है,\nमेहनत ही सबसे बड़ी तैयारी है।"},
{"id":441,"category":"मोटिवेशन","text":"हर सुबह खुद से एक वादा करना,\nकल से बेहतर आज को बनाना।"},
{"id":442,"category":"मोटिवेशन","text":"रास्ते मुश्किल हों तो सीखते जाना,\nअपने हौसले को आगे बढ़ाते जाना।"},
{"id":443,"category":"मोटिवेशन","text":"सफलता की राह धैर्य माँगती है,\nलगन हर मुश्किल को आसान बनाती है।"},
{"id":444,"category":"मोटिवेशन","text":"समय की क़द्र करने वाला आगे जाता है,\nमेहनत करने वाला नया मुक़ाम पाता है।"},
{"id":445,"category":"मोटिवेशन","text":"अपनी ताक़त को पहचानो,\nहर दिन नया हुनर जानो।"},
{"id":446,"category":"मोटिवेशन","text":"छोटी शुरुआत से मत घबराना,\nबड़ा सपना देखकर कदम बढ़ाना।"},
{"id":447,"category":"मोटिवेशन","text":"ज्ञान की रोशनी फैलाते रहो,\nसीखने का दीप जलाते रहो।"},
{"id":448,"category":"मोटिवेशन","text":"जो अपने काम से प्यार करता है,\nवह हर दिन कुछ नया तैयार करता है।"},
{"id":449,"category":"मोटिवेशन","text":"लक्ष्य को लिखकर सामने रखो,\nहर दिन अपने प्रयास पर नज़र रखो।"},
{"id":450,"category":"मोटिवेशन","text":"सपनों की कीमत मेहनत से चुकाना,\nअपनी मंज़िल तक चलते जाना।"},
{"id":451,"category":"भक्ति","text":"हर सुबह मन में आभार जगाना,\nईश्वर की बनाई दुनिया को अपनाना।"},
{"id":452,"category":"भक्ति","text":"सच्चे मन में प्रेम का वास हो,\nहर इंसान के लिए सम्मान का भाव हो।"},
{"id":453,"category":"भक्ति","text":"सेवा से बढ़कर कोई पहचान नहीं,\nदया से सुंदर कोई इंसान नहीं।"},
{"id":454,"category":"भक्ति","text":"प्रभु का नाम मन में बसाए रखना,\nहर हाल में अच्छाई अपनाए रखना।"},
{"id":455,"category":"भक्ति","text":"अच्छे कर्मों का फल अच्छा होता है,\nसच्चा मन सबसे सुंदर होता है।"},
{"id":456,"category":"भक्ति","text":"मन में शांति का दीप जलाना,\nहर जीव के प्रति दया दिखाना।"},
{"id":457,"category":"भक्ति","text":"धर्म का संदेश प्रेम फैलाना है,\nहर दिल में इंसानियत जगाना है।"},
{"id":458,"category":"भक्ति","text":"विनम्रता से हर राह आसान होती है,\nसेवा से जीवन की पहचान होती है।"},
{"id":459,"category":"भक्ति","text":"किसी भूखे को भोजन कराना,\nकिसी उदास चेहरे को हँसाना।"},
{"id":460,"category":"भक्ति","text":"प्रार्थना में सबका भला माँगना,\nअपने कर्मों को सच्चा रखना।"},
{"id":461,"category":"देशभक्ति","text":"देश की मिट्टी का मान बढ़ाएँ,\nमिलकर विकास की राह बनाएँ।"},
{"id":462,"category":"देशभक्ति","text":"तिरंगा हर दिल की शान है,\nभारत हमारी पहचान है।"},
{"id":463,"category":"देशभक्ति","text":"एकता से मजबूत समाज बनता है,\nमिलकर चलने से देश आगे बढ़ता है।"},
{"id":464,"category":"देशभक्ति","text":"हर बच्चे को शिक्षा का अधिकार मिले,\nहर मेहनतकश को सम्मान मिले।"},
{"id":465,"category":"देशभक्ति","text":"स्वच्छ शहर और हरे-भरे गाँव बनाएँ,\nअपने देश को सुंदर बनाएँ।"},
{"id":466,"category":"देशभक्ति","text":"विज्ञान और ज्ञान की ज्योति जलाएँ,\nभारत को नई ऊँचाइयों तक पहुँचाएँ।"},
{"id":467,"category":"देशभक्ति","text":"अलग संस्कृति फिर भी एक विचार,\nभारत की एकता सबसे शानदार।"},
{"id":468,"category":"देशभक्ति","text":"कर्म से देश का नाम रोशन करें,\nईमानदारी से अपना जीवन सफल करें।"},
{"id":469,"category":"देशभक्ति","text":"देश के हर नागरिक का सम्मान करें,\nमिलकर बेहतर कल का निर्माण करें।"},
{"id":470,"category":"देशभक्ति","text":"अपने वतन से प्यार जताते रहें,\nअच्छे कामों से इसे सजाते रहें।"},
{"id":471,"category":"रात","text":"रात की चाँदनी मन को भाती है,\nधीरे से कोई याद दिलाती है।"},
{"id":472,"category":"रात","text":"सितारों की महफ़िल सजी हुई है,\nरात सपनों से भरी हुई है।"},
{"id":473,"category":"रात","text":"चाँद आसमान में चमकता रहे,\nहर दिल उम्मीद से दमकता रहे।"},
{"id":474,"category":"रात","text":"दिन की थकान को पीछे छोड़ो,\nसुंदर सपनों से नाता जोड़ो।"},
{"id":475,"category":"रात","text":"रात के सन्नाटे में सुकून है,\nसुबह की उम्मीद में जुनून है।"},
{"id":476,"category":"रात","text":"चाँदनी रात में हवा गुनगुनाती है,\nख़ामोशी भी गीत सुनाती है।"},
{"id":477,"category":"रात","text":"आँखों में मीठे सपने सजाना,\nसुबह उठकर नई राह बनाना।"},
{"id":478,"category":"रात","text":"रात गुजरकर सुबह बन जाती है,\nउम्मीद हर मुश्किल मिटाती है।"},
{"id":479,"category":"रात","text":"तारों को देखकर ख़्वाब बनाते हैं,\nनई सुबह के इरादे सजाते हैं।"},
{"id":480,"category":"रात","text":"शांत रात का आनंद उठाना,\nकल के लिए नई ऊर्जा बचाना।"},
{"id":481,"category":"परिवार","text":"माँ के हाथों का खाना याद आता है,\nघर का हर कोना पास बुलाता है।"},
{"id":482,"category":"परिवार","text":"पिता की मेहनत प्रेरणा बन जाती है,\nउनकी सीख जीवन राह दिखाती है।"},
{"id":483,"category":"परिवार","text":"बहन की मुस्कान घर का उजाला है,\nभाई का साथ भी निराला है।"},
{"id":484,"category":"परिवार","text":"अपनों के साथ बैठकर बातें करना,\nछोटी खुशियों को मिलकर जीना।"},
{"id":485,"category":"परिवार","text":"घर में प्यार का दीप जलाए रखना,\nहर रिश्ते को दिल से निभाए रखना।"},
{"id":486,"category":"परिवार","text":"दादा-दादी की बातें ख़ज़ाना हैं,\nउनके अनुभव जीवन का फ़साना हैं।"},
{"id":487,"category":"परिवार","text":"परिवार का साथ सबसे प्यारा है,\nयही जीवन का मजबूत सहारा है।"},
{"id":488,"category":"परिवार","text":"अपनों की छोटी बात समझना,\nरिश्तों में धैर्य और प्यार रखना।"},
{"id":489,"category":"परिवार","text":"घर की हँसी कभी कम न होने देना,\nअपनों का भरोसा कभी कम न होने देना।"},
{"id":490,"category":"परिवार","text":"मिलकर रहना सबसे बड़ी दौलत है,\nपरिवार ही जीवन की असली ताक़त है।"},
{"id":491,"category":"ज़िंदगी","text":"ज़िंदगी को मुस्कुराकर जीना सीखो,\nहर नए दिन से कुछ नया सीखो।"},
{"id":492,"category":"ज़िंदगी","text":"छोटी खुशियों का हिसाब रखो,\nअपने दिल में उम्मीदों की किताब रखो।"},
{"id":493,"category":"ज़िंदगी","text":"हर इंसान की अपनी कहानी है,\nहर अनुभव की अलग निशानी है।"},
{"id":494,"category":"ज़िंदगी","text":"आज का पल अनमोल समझना,\nअपने सपनों का मोल समझना।"},
{"id":495,"category":"ज़िंदगी","text":"गलतियों से घबराना नहीं,\nसीखने का अवसर गँवाना नहीं।"},
{"id":496,"category":"ज़िंदगी","text":"सच्चाई से अपना जीवन सजाना,\nहर किसी के साथ अच्छा व्यवहार निभाना।"},
{"id":497,"category":"ज़िंदगी","text":"खुश रहना भी एक कला है,\nउम्मीद रखना सबसे भला है।"},
{"id":498,"category":"ज़िंदगी","text":"अपने कर्मों पर ध्यान लगाना,\nदूसरों से तुलना छोड़ जाना।"},
{"id":499,"category":"ज़िंदगी","text":"हर दिन नया मौका लेकर आता है,\nजो सीखता है वही आगे जाता है।"},
{"id":500,"category":"ज़िंदगी","text":"जीवन का सफ़र प्यार से सजाना,\nहर दिन को यादगार बनाना।"}
</escape>
